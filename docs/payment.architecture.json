{
  "version": "1.0.0",
  "metadata": {
    "title": "Payment System Architecture",
    "description": "A comprehensive payment processing system architecture supporting multiple payment methods, fraud detection, and compliance requirements",
    "created": "2026-01-03",
    "author": "Architecture Team",
    "tags": ["payments", "fintech", "microservices", "security"]
  },
  "nodes": [
    {
      "unique-id": "web-client",
      "node-type": "client",
      "name": "Web Client Application",
      "description": "Frontend web application for customer payment interactions",
      "interfaces": [
        {
          "unique-id": "web-interface",
          "type": "web-interface",
          "protocol": "HTTPS",
          "port": 443
        }
      ]
    },
    {
      "unique-id": "mobile-client",
      "node-type": "client", 
      "name": "Mobile Client Application",
      "description": "Mobile application for payment processing on iOS and Android",
      "interfaces": [
        {
          "unique-id": "mobile-interface",
          "type": "mobile-interface",
          "protocol": "HTTPS",
          "port": 443
        }
      ]
    },
    {
      "unique-id": "api-gateway",
      "node-type": "gateway",
      "name": "API Gateway",
      "description": "Central entry point for all client requests, handles authentication, rate limiting, and routing",
      "interfaces": [
        {
          "unique-id": "external-api",
          "type": "rest-api",
          "protocol": "HTTPS",
          "host": "api.payments.example.com",
          "port": 443,
          "path": "/api/v1"
        },
        {
          "unique-id": "internal-routing",
          "type": "internal-interface",
          "protocol": "HTTP",
          "port": 8080
        }
      ],
      "data-classification": "PII"
    },
    {
      "unique-id": "payment-service",
      "node-type": "service",
      "name": "Payment Processing Service",
      "description": "Core payment processing logic, orchestrates payment flows and manages transaction states",
      "interfaces": [
        {
          "unique-id": "payment-api",
          "type": "rest-api",
          "protocol": "HTTP",
          "host": "payment-service.internal",
          "port": 8081,
          "path": "/payments"
        }
      ],
      "data-classification": "PII"
    },
    {
      "unique-id": "fraud-detection-service",
      "node-type": "service",
      "name": "Fraud Detection Service",
      "description": "Real-time fraud detection and risk assessment using ML models",
      "interfaces": [
        {
          "unique-id": "fraud-api",
          "type": "rest-api",
          "protocol": "HTTP",
          "host": "fraud-service.internal",
          "port": 8082,
          "path": "/fraud-check"
        }
      ],
      "data-classification": "PII"
    },
    {
      "unique-id": "notification-service",
      "node-type": "service",
      "name": "Notification Service",
      "description": "Handles email, SMS, and push notifications for payment events",
      "interfaces": [
        {
          "unique-id": "notification-api",
          "type": "rest-api",
          "protocol": "HTTP",
          "host": "notification-service.internal",
          "port": 8083,
          "path": "/notifications"
        }
      ]
    },
    {
      "unique-id": "user-service",
      "node-type": "service",
      "name": "User Management Service",
      "description": "Manages user accounts, authentication, and authorization",
      "interfaces": [
        {
          "unique-id": "user-api",
          "type": "rest-api",
          "protocol": "HTTP",
          "host": "user-service.internal",
          "port": 8084,
          "path": "/users"
        }
      ],
      "data-classification": "PII"
    },
    {
      "unique-id": "payment-gateway-stripe",
      "node-type": "external-service",
      "name": "Stripe Payment Gateway",
      "description": "External payment processor for credit card transactions",
      "interfaces": [
        {
          "unique-id": "stripe-api",
          "type": "rest-api",
          "protocol": "HTTPS",
          "host": "api.stripe.com",
          "port": 443,
          "path": "/v1"
        }
      ],
      "data-classification": "PCI-DSS"
    },
    {
      "unique-id": "payment-gateway-paypal",
      "node-type": "external-service",
      "name": "PayPal Payment Gateway",
      "description": "External payment processor for PayPal transactions",
      "interfaces": [
        {
          "unique-id": "paypal-api",
          "type": "rest-api",
          "protocol": "HTTPS",
          "host": "api.paypal.com",
          "port": 443,
          "path": "/v2"
        }
      ],
      "data-classification": "PCI-DSS"
    },
    {
      "unique-id": "payment-db",
      "node-type": "database",
      "name": "Payment Database",
      "description": "Primary database for payment transactions and related data",
      "interfaces": [
        {
          "unique-id": "payment-db-interface",
          "type": "database-interface",
          "protocol": "PostgreSQL",
          "host": "payment-db.internal",
          "port": 5432,
          "database": "payments",
          "username": "${DB_USERNAME}",
          "password": "${DB_PASSWORD}"
        }
      ],
      "data-classification": "PII"
    },
    {
      "unique-id": "user-db",
      "node-type": "database",
      "name": "User Database",
      "description": "Database for user accounts and profile information",
      "interfaces": [
        {
          "unique-id": "user-db-interface",
          "type": "database-interface",
          "protocol": "PostgreSQL",
          "host": "user-db.internal",
          "port": 5432,
          "database": "users",
          "username": "${USER_DB_USERNAME}",
          "password": "${USER_DB_PASSWORD}"
        }
      ],
      "data-classification": "PII"
    },
    {
      "unique-id": "redis-cache",
      "node-type": "cache",
      "name": "Redis Cache",
      "description": "In-memory cache for session data, rate limiting, and temporary data",
      "interfaces": [
        {
          "unique-id": "redis-interface",
          "type": "cache-interface",
          "protocol": "Redis",
          "host": "redis.internal",
          "port": 6379
        }
      ]
    },
    {
      "unique-id": "message-queue",
      "node-type": "message-broker",
      "name": "RabbitMQ Message Queue",
      "description": "Message broker for asynchronous communication between services",
      "interfaces": [
        {
          "unique-id": "rabbitmq-interface",
          "type": "message-interface",
          "protocol": "AMQP",
          "host": "rabbitmq.internal",
          "port": 5672
        }
      ]
    },
    {
      "unique-id": "audit-service",
      "node-type": "service",
      "name": "Audit Service",
      "description": "Logs and tracks all payment-related activities for compliance and monitoring",
      "interfaces": [
        {
          "unique-id": "audit-api",
          "type": "rest-api",
          "protocol": "HTTP",
          "host": "audit-service.internal",
          "port": 8085,
          "path": "/audit"
        }
      ],
      "data-classification": "Audit"
    },
    {
      "unique-id": "monitoring-system",
      "node-type": "monitoring",
      "name": "Monitoring and Alerting System",
      "description": "Centralized monitoring, logging, and alerting for the payment system",
      "interfaces": [
        {
          "unique-id": "monitoring-interface",
          "type": "monitoring-interface",
          "protocol": "HTTP",
          "host": "monitoring.internal",
          "port": 9090
        }
      ]
    }
  ],
  "relationships": [
    {
      "unique-id": "web-client-to-gateway",
      "description": "Web client sends payment requests to API gateway",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "web-client"
          },
          "destination": {
            "node": "api-gateway",
            "interfaces": ["external-api"]
          }
        }
      },
      "protocol": "HTTPS"
    },
    {
      "unique-id": "mobile-client-to-gateway",
      "description": "Mobile client sends payment requests to API gateway",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "mobile-client"
          },
          "destination": {
            "node": "api-gateway",
            "interfaces": ["external-api"]
          }
        }
      },
      "protocol": "HTTPS"
    },
    {
      "unique-id": "gateway-to-payment-service",
      "description": "API gateway routes payment requests to payment service",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "api-gateway"
          },
          "destination": {
            "node": "payment-service",
            "interfaces": ["payment-api"]
          }
        }
      },
      "protocol": "HTTP"
    },
    {
      "unique-id": "gateway-to-user-service",
      "description": "API gateway routes user management requests to user service",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "api-gateway"
          },
          "destination": {
            "node": "user-service",
            "interfaces": ["user-api"]
          }
        }
      },
      "protocol": "HTTP"
    },
    {
      "unique-id": "payment-service-to-fraud-detection",
      "description": "Payment service calls fraud detection for risk assessment",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "payment-service"
          },
          "destination": {
            "node": "fraud-detection-service",
            "interfaces": ["fraud-api"]
          }
        }
      },
      "protocol": "HTTP"
    },
    {
      "unique-id": "payment-service-to-stripe",
      "description": "Payment service processes credit card payments via Stripe",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "payment-service"
          },
          "destination": {
            "node": "payment-gateway-stripe",
            "interfaces": ["stripe-api"]
          }
        }
      },
      "protocol": "HTTPS"
    },
    {
      "unique-id": "payment-service-to-paypal",
      "description": "Payment service processes PayPal payments",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "payment-service"
          },
          "destination": {
            "node": "payment-gateway-paypal",
            "interfaces": ["paypal-api"]
          }
        }
      },
      "protocol": "HTTPS"
    },
    {
      "unique-id": "payment-service-to-payment-db",
      "description": "Payment service stores transaction data in payment database",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "payment-service"
          },
          "destination": {
            "node": "payment-db",
            "interfaces": ["payment-db-interface"]
          }
        }
      },
      "protocol": "PostgreSQL"
    },
    {
      "unique-id": "user-service-to-user-db",
      "description": "User service manages user data in user database",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "user-service"
          },
          "destination": {
            "node": "user-db",
            "interfaces": ["user-db-interface"]
          }
        }
      },
      "protocol": "PostgreSQL"
    },
    {
      "unique-id": "api-gateway-to-redis",
      "description": "API gateway uses Redis for session management and rate limiting",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "api-gateway"
          },
          "destination": {
            "node": "redis-cache",
            "interfaces": ["redis-interface"]
          }
        }
      },
      "protocol": "Redis"
    },
    {
      "unique-id": "payment-service-to-notification",
      "description": "Payment service sends notification requests via message queue",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "payment-service"
          },
          "destination": {
            "node": "message-queue",
            "interfaces": ["rabbitmq-interface"]
          }
        }
      },
      "protocol": "AMQP"
    },
    {
      "unique-id": "notification-service-to-queue",
      "description": "Notification service consumes messages from message queue",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "notification-service"
          },
          "destination": {
            "node": "message-queue",
            "interfaces": ["rabbitmq-interface"]
          }
        }
      },
      "protocol": "AMQP"
    },
    {
      "unique-id": "payment-service-to-audit",
      "description": "Payment service logs audit events to audit service",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "payment-service"
          },
          "destination": {
            "node": "audit-service",
            "interfaces": ["audit-api"]
          }
        }
      },
      "protocol": "HTTP"
    },
    {
      "unique-id": "fraud-detection-to-audit",
      "description": "Fraud detection service logs fraud events to audit service",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "fraud-detection-service"
          },
          "destination": {
            "node": "audit-service",
            "interfaces": ["audit-api"]
          }
        }
      },
      "protocol": "HTTP"
    },
    {
      "unique-id": "all-services-to-monitoring",
      "description": "All services send metrics and logs to monitoring system",
      "relationship-type": {
        "observes": {
          "source": {
            "node": "monitoring-system"
          },
          "destination": {
            "nodes": [
              "api-gateway",
              "payment-service", 
              "fraud-detection-service",
              "notification-service",
              "user-service",
              "audit-service"
            ]
          }
        }
      },
      "protocol": "HTTP"
    }
  ]
}
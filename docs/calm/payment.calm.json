{
  "calm-version": "1.0.0",
  "metadata": {
    "name": "Payment System Architecture",
    "description": "A comprehensive payment processing system with multiple payment methods, fraud detection, and settlement capabilities",
    "owner": "Platform Engineering Team",
    "created": "2026-01-03",
    "version": "1.0.0"
  },
  "nodes": [
    {
      "unique-id": "payment-gateway",
      "node-type": "service",
      "name": "Payment Gateway",
      "description": "Main entry point for payment requests, handles routing and orchestration",
      "interfaces": [
        {
          "unique-id": "payment-gateway-api",
          "name": "Payment API",
          "protocol": "REST",
          "port": 8080,
          "path": "/api/v1/payments"
        }
      ],
      "data-classification": "PCI-DSS Level 1"
    },
    {
      "unique-id": "payment-processor",
      "node-type": "service",
      "name": "Payment Processor",
      "description": "Processes payment transactions and communicates with payment providers",
      "interfaces": [
        {
          "unique-id": "payment-processor-api",
          "name": "Processor API",
          "protocol": "gRPC",
          "port": 9090
        }
      ],
      "data-classification": "PCI-DSS Level 1"
    },
    {
      "unique-id": "fraud-detection",
      "node-type": "service",
      "name": "Fraud Detection Service",
      "description": "Real-time fraud detection and risk scoring using ML models",
      "interfaces": [
        {
          "unique-id": "fraud-detection-api",
          "name": "Fraud Check API",
          "protocol": "REST",
          "port": 8081,
          "path": "/api/v1/fraud-check"
        }
      ],
      "data-classification": "Confidential"
    },
    {
      "unique-id": "payment-vault",
      "node-type": "service",
      "name": "Payment Vault",
      "description": "Secure storage for tokenized payment methods and sensitive card data",
      "interfaces": [
        {
          "unique-id": "vault-api",
          "name": "Vault API",
          "protocol": "REST",
          "port": 8082,
          "path": "/api/v1/vault"
        }
      ],
      "data-classification": "PCI-DSS Level 1"
    },
    {
      "unique-id": "settlement-service",
      "node-type": "service",
      "name": "Settlement Service",
      "description": "Handles payment settlement, reconciliation, and payout processing",
      "interfaces": [
        {
          "unique-id": "settlement-api",
          "name": "Settlement API",
          "protocol": "REST",
          "port": 8083,
          "path": "/api/v1/settlements"
        }
      ],
      "data-classification": "Financial"
    },
    {
      "unique-id": "notification-service",
      "node-type": "service",
      "name": "Notification Service",
      "description": "Sends payment notifications via email, SMS, and webhooks",
      "interfaces": [
        {
          "unique-id": "notification-api",
          "name": "Notification API",
          "protocol": "REST",
          "port": 8084,
          "path": "/api/v1/notifications"
        }
      ],
      "data-classification": "Internal"
    },
    {
      "unique-id": "payment-db",
      "node-type": "datastore",
      "name": "Payment Database",
      "description": "PostgreSQL database storing payment transactions and metadata",
      "database-type": "PostgreSQL",
      "data-classification": "PCI-DSS Level 1"
    },
    {
      "unique-id": "vault-db",
      "node-type": "datastore",
      "name": "Vault Database",
      "description": "Encrypted database for tokenized payment methods",
      "database-type": "PostgreSQL",
      "encryption": "AES-256",
      "data-classification": "PCI-DSS Level 1"
    },
    {
      "unique-id": "event-bus",
      "node-type": "system",
      "name": "Event Bus",
      "description": "Apache Kafka event streaming platform for async communication",
      "system-type": "message-broker"
    },
    {
      "unique-id": "stripe-provider",
      "node-type": "external-service",
      "name": "Stripe Payment Provider",
      "description": "External payment provider for card processing",
      "interfaces": [
        {
          "unique-id": "stripe-api",
          "name": "Stripe API",
          "protocol": "REST",
          "url": "https://api.stripe.com"
        }
      ]
    },
    {
      "unique-id": "paypal-provider",
      "node-type": "external-service",
      "name": "PayPal Payment Provider",
      "description": "External payment provider for PayPal transactions",
      "interfaces": [
        {
          "unique-id": "paypal-api",
          "name": "PayPal API",
          "protocol": "REST",
          "url": "https://api.paypal.com"
        }
      ]
    },
    {
      "unique-id": "api-gateway",
      "node-type": "system",
      "name": "API Gateway",
      "description": "Kong API Gateway for external client access",
      "system-type": "gateway"
    }
  ],
  "relationships": [
    {
      "unique-id": "rel-gateway-processor",
      "relationship-type": "interaction",
      "source": "payment-gateway",
      "destination": "payment-processor",
      "protocol": "gRPC",
      "description": "Gateway sends payment requests to processor"
    },
    {
      "unique-id": "rel-gateway-fraud",
      "relationship-type": "interaction",
      "source": "payment-gateway",
      "destination": "fraud-detection",
      "protocol": "REST",
      "description": "Gateway requests fraud check before processing"
    },
    {
      "unique-id": "rel-gateway-vault",
      "relationship-type": "interaction",
      "source": "payment-gateway",
      "destination": "payment-vault",
      "protocol": "REST",
      "description": "Gateway retrieves tokenized payment methods"
    },
    {
      "unique-id": "rel-processor-stripe",
      "relationship-type": "interaction",
      "source": "payment-processor",
      "destination": "stripe-provider",
      "protocol": "REST",
      "description": "Processor sends card payments to Stripe"
    },
    {
      "unique-id": "rel-processor-paypal",
      "relationship-type": "interaction",
      "source": "payment-processor",
      "destination": "paypal-provider",
      "protocol": "REST",
      "description": "Processor sends PayPal payments to PayPal API"
    },
    {
      "unique-id": "rel-gateway-db",
      "relationship-type": "interaction",
      "source": "payment-gateway",
      "destination": "payment-db",
      "protocol": "SQL",
      "description": "Gateway persists payment records"
    },
    {
      "unique-id": "rel-vault-db",
      "relationship-type": "interaction",
      "source": "payment-vault",
      "destination": "vault-db",
      "protocol": "SQL",
      "description": "Vault stores encrypted payment methods"
    },
    {
      "unique-id": "rel-gateway-events",
      "relationship-type": "interaction",
      "source": "payment-gateway",
      "destination": "event-bus",
      "protocol": "Kafka",
      "description": "Gateway publishes payment events"
    },
    {
      "unique-id": "rel-settlement-events",
      "relationship-type": "interaction",
      "source": "settlement-service",
      "destination": "event-bus",
      "protocol": "Kafka",
      "description": "Settlement service consumes payment events"
    },
    {
      "unique-id": "rel-notification-events",
      "relationship-type": "interaction",
      "source": "notification-service",
      "destination": "event-bus",
      "protocol": "Kafka",
      "description": "Notification service consumes payment events"
    },
    {
      "unique-id": "rel-api-gateway",
      "relationship-type": "interaction",
      "source": "api-gateway",
      "destination": "payment-gateway",
      "protocol": "REST",
      "description": "API Gateway routes external requests to payment gateway"
    }
  ],
  "patterns": [
    {
      "name": "Event-Driven Architecture",
      "description": "Services communicate asynchronously via Kafka event bus for loose coupling",
      "components": ["payment-gateway", "settlement-service", "notification-service", "event-bus"]
    },
    {
      "name": "API Gateway Pattern",
      "description": "Single entry point for external clients with authentication and rate limiting",
      "components": ["api-gateway", "payment-gateway"]
    },
    {
      "name": "Tokenization Pattern",
      "description": "Sensitive payment data is tokenized and stored securely in vault",
      "components": ["payment-vault", "vault-db"]
    },
    {
      "name": "Circuit Breaker",
      "description": "Payment processor implements circuit breaker for external provider calls",
      "components": ["payment-processor", "stripe-provider", "paypal-provider"]
    }
  ]
}
